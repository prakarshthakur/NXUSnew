rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Events: anyone authenticated can read, only the host can create
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    // Join Requests: authenticated users can create their own, read their own or requests for events they host
    match /joinRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
