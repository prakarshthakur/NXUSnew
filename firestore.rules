rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users: anyone authenticated can read, only the owner can write their own doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
    }

    // Events: anyone authenticated can read, only the host can create/update/delete
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    // Join Requests: authenticated users can create their own, read all, host can update status
    match /joinRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.hostUid == request.auth.uid
      );
    }

    // Usernames: public read for profile lookups; owner or admin can delete (on username change)
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
      allow update: if false;
    }

    // Alpha keys: public read to check if used, create-once (Firestore rejects duplicate creates),
    // never updatable or deletable — safe because doc IDs are SHA-256 hashes of the actual keys
    match /alphaKeys/{keyHash} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
