rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
    }

    // ── Events ──
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
      allow delete: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
    }

    // ── Join Requests ──
    match /joinRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/events/
            $(resource.data.eventId)).data.hostUid == request.auth.uid ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
    }

    // ── Usernames ──
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.email == 'prakarshthakur1@gmail.com'
      );
      allow update: if false;
    }

    // ── Alpha Keys ──
    match /alphaKeys/{keyHash} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ── Config (admin-managed settings) ──
    match /config/{docId} {
      // emailSuffixes must be readable before auth so signup can enforce it
      allow read: if request.auth != null || docId == 'emailSuffixes';
      allow write: if request.auth != null &&
        request.auth.token.email == 'prakarshthakur1@gmail.com';
    }

    // ── Public stats (unauthenticated readable) ──
    match /public/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
