rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users: anyone authenticated can read, only the owner can write their own doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Events: anyone authenticated can read, only the host can create/update/delete
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    // Join Requests: authenticated users can create their own, read all, host can update status
    match /joinRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
